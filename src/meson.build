sources = files(
    'Application.vala',
    'Config.vala',
    'Utils/Debug.vala',
    'Utils/Work.vala',
    'MainWindow.vala',

    'Models/BrowseResult.vala',
    'Models/Channel.vala',
    'Models/Comment.vala',
    'Models/Playlist.vala',
    'Models/Shelf.vala',
    'Models/Video.vala',

    'Services/DeviceAuth.vala',
    'Services/InnertubeClient.vala',
    'Services/MediaFormat.vala',
    'Services/PlaybackInfo.vala',
    'Services/ProtoReader.vala',
    'Services/ProtoWriter.vala',
    'Services/SabrClient.vala',
    'Services/HttpSession.vala',
    'Services/SabrRequest.vala',
    'Services/SiteConfig.vala',
    'Services/UmpReader.vala',
    'Services/Library.vala',
    'Services/ResponseParser.vala',
    'Services/ThumbnailCache.vala',
    'Services/TokenStore.vala',

    'Views/AccountView.vala',
    'Views/BrowseView.vala',
    'Views/ChannelView.vala',
    'Views/ChannelsView.vala',
    'Views/DiscoverView.vala',
    'Views/HistoryView.vala',
    'Views/MiniplayerWindow.vala',
    'Views/PlaylistView.vala',
    'Views/PreferencesWindow.vala',
    'Views/SearchView.vala',
    'Views/ShortcutsWindow.vala',
    'Views/WatchLaterView.vala',
    'Views/WatchView.vala',

    'Widgets/ChannelRow.vala',
    'Widgets/CommentRow.vala',
    'Widgets/NoticeBar.vala',
    'Widgets/ResultCard.vala',
    'Widgets/ShelfView.vala',
    'Widgets/SizedPaintable.vala',
    'Widgets/Sidebar.vala',
    'Widgets/StatusView.vala',
    'Widgets/Thumbnail.vala',
    'Widgets/VideoPlayer.vala',
    'Widgets/VideoRow.vala'
)

executable(
    meson.project_name(),
    sources,
    gresource,
    dependencies: [
        dependency('glib-2.0', version: '>= 2.74'),
        dependency('gio-2.0'),
        dependency('gee-0.8'),
        dependency('gtk4', version: '>= 4.10'),
        dependency('granite-7', version: '>= 7.4.0'),
        dependency('gstreamer-1.0'),
        dependency('gstreamer-app-1.0'),
        dependency('json-glib-1.0'),
        dependency('libsoup-3.0'),
    ],
    install: true
)
